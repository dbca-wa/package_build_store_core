#!/bin/sh

set -e

if command -v ldconfig >/dev/null 2>&1; then
    ldconfig
fi

if [ "$1" = "configure" ]; then

    if [ ! -x /usr/local/bin/python3.15 ]; then
        echo "Python 3.15 installation validation failed." >&2
        echo "Expected: /usr/local/bin/python3.15" >&2
        exit 1
    fi

    echo "Validating DBCA Python installation..."

    /usr/local/bin/python3.15 --version

    /usr/local/bin/python3.15 -c '
import sys
import ssl
import sqlite3
import zlib

print("Python:", sys.version)
print("OpenSSL:", ssl.OPENSSL_VERSION)
print("SQLite:", sqlite3.sqlite_version)
print("zlib:", zlib.ZLIB_VERSION)
print("DBCA Python validation passed")
'

fi

exit 0
