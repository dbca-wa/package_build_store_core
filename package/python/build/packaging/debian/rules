#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PACKAGE_DIR := $(CURDIR)/debian/python3.15-dbca

%:
	dh $@

override_dh_auto_configure:
	mkdir -p build-dbca
	cd build-dbca && ../configure \
		--prefix=/usr/local \
		--enable-optimizations \
		--enable-shared \
		--with-ensurepip=install \
		--with-lto \
		--with-system-expat \
		--with-system-ffi

override_dh_auto_build:
	$(MAKE) -C build-dbca -j"$$(nproc)"

override_dh_auto_test:
	$(MAKE) -C build-dbca test \
		TESTOPTS="-j$$(nproc) --timeout 120"

override_dh_auto_install:
	$(MAKE) -C build-dbca \
		DESTDIR="$(PACKAGE_DIR)" \
		altinstall

	install -d "$(PACKAGE_DIR)/usr/bin"

	ln -sf /usr/local/bin/python3.15 \
		"$(PACKAGE_DIR)/usr/bin/python"

	ln -sf /usr/local/bin/python3.15 \
		"$(PACKAGE_DIR)/usr/bin/python3"

	ln -sf /usr/local/bin/python3.15 \
		"$(PACKAGE_DIR)/usr/bin/python3.15"

	ln -sf /usr/local/bin/pip3.15 \
		"$(PACKAGE_DIR)/usr/bin/pip"

	ln -sf /usr/local/bin/pip3.15 \
		"$(PACKAGE_DIR)/usr/bin/pip3"

	ln -sf /usr/local/bin/pip3.15 \
		"$(PACKAGE_DIR)/usr/bin/pip3.15"

	install -d "$(PACKAGE_DIR)/etc/ld.so.conf.d"

	printf '%s\n' '/usr/local/lib' \
		> "$(PACKAGE_DIR)/etc/ld.so.conf.d/python3.15-dbca.conf"

override_dh_shlibdeps:
	dh_shlibdeps \
		-l$(PACKAGE_DIR)/usr/local/lib

override_dh_missing:
	dh_missing --fail-missing
