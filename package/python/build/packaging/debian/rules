#!/usr/bin/make -f

export DH_VERBOSE = 1

# Enable Debian compiler and linker hardening.
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

PACKAGE_NAME := python3.15-dbca
PACKAGE_DIR := $(CURDIR)/debian/$(PACKAGE_NAME)
BUILD_DIR := $(CURDIR)/build-dbca
PYTHON_PREFIX := /usr/local


#
# CPython already provides a generated configure script.
#
# Do not run dh_autoreconf against the CPython source tree.
#
%:
	dh $@ --without autoreconf


#
# Remove any previous out-of-tree build directory.
#
override_dh_auto_clean:
	rm -rf "$(BUILD_DIR)"
	dh_auto_clean


#
# Configure CPython using an out-of-tree build.
#
override_dh_auto_configure:
	rm -rf "$(BUILD_DIR)"
	mkdir -p "$(BUILD_DIR)"

	cd "$(BUILD_DIR)" && ../configure \
		--prefix="$(PYTHON_PREFIX)" \
		--enable-optimizations \
		--enable-shared \
		--with-ensurepip=install


#
# Build CPython.
#
# DEB_BUILD_OPTIONS can provide the parallel level, but nproc is
# retained here so this behaves like the original source build.
#
override_dh_auto_build:
	$(MAKE) -C "$(BUILD_DIR)" -j"$$(nproc)"


#
# Run the CPython test suite.
#
override_dh_auto_test:
	$(MAKE) -C "$(BUILD_DIR)" test \
		TESTOPTS="-j$$(nproc) --timeout 120"


#
# Install CPython into the Debian package staging directory.
#
# This does not install anything into the live builder container.
#
override_dh_auto_install:
	$(MAKE) -C "$(BUILD_DIR)" \
		DESTDIR="$(PACKAGE_DIR)" \
		altinstall

	#
	# Make the DBCA Python build the default application Python.
	#
	# /usr/local/bin normally precedes /usr/bin in PATH, so this
	# leaves Ubuntu's system Python in /usr/bin intact while making
	# Python 3.15 the default application interpreter.
	#
	ln -sf python3.15 \
		"$(PACKAGE_DIR)/usr/local/bin/python"

	ln -sf python3.15 \
		"$(PACKAGE_DIR)/usr/local/bin/python3"

	#
	# Create the pip aliases when ensurepip installed pip3.15.
	#
	if [ -e "$(PACKAGE_DIR)/usr/local/bin/pip3.15" ]; then \
		ln -sf pip3.15 \
			"$(PACKAGE_DIR)/usr/local/bin/pip"; \
		ln -sf pip3.15 \
			"$(PACKAGE_DIR)/usr/local/bin/pip3"; \
	fi

	#
	# Register /usr/local/lib because --enable-shared creates
	# libpython3.15.so under that directory.
	#
	install -d \
		"$(PACKAGE_DIR)/etc/ld.so.conf.d"

	printf '%s\n' '/usr/local/lib' \
		> "$(PACKAGE_DIR)/etc/ld.so.conf.d/python3.15-dbca.conf"

	#
	# Remove test suites from the final runtime package.
	#
	rm -rf \
		"$(PACKAGE_DIR)/usr/local/lib/python3.15/test" \
		"$(PACKAGE_DIR)/usr/local/lib/python3.15/idlelib/idle_test" \
		"$(PACKAGE_DIR)/usr/local/lib/python3.15/tkinter/test"

	#
	# Remove build-generated Python bytecode caches.
	#
	find "$(PACKAGE_DIR)" \
		-type d \
		-name '__pycache__' \
		-prune \
		-exec rm -rf '{}' '+'


#
# Calculate native shared-library dependencies for the Python
# executable and compiled extension modules.
#
# Include the package's staged /usr/local/lib directory so
# dh_shlibdeps can locate libpython3.15.so.
#
override_dh_shlibdeps:
	dh_shlibdeps \
		-l"$(PACKAGE_DIR)/usr/local/lib"


#
# Fail if files generated during installation are not included
# in the resulting Debian package.
#
override_dh_missing:
	dh_missing --fail-missing
